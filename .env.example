# CIIS System Environment Configuration
# ========================================================

# Google Gemini API Key for AI Excel Problem Solver & Teacher Assistant
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Specify the Google Gemini model (defaults to gemini-2.5-flash)
# Supported vision models: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Configuration
PORT=4001
